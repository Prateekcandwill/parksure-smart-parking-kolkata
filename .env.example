# ParkSure build-time configuration.
#
# Copy this file to `.env.local` and change any value you need. Every key is
# optional; the app falls back to the public demo defaults below.
#
# IMPORTANT: Vite exposes every VITE_* value to the browser. Never put a real
# gateway key, OTP-delivery key, database password or signing secret here.
# Production secrets belong on a server, behind a serverless function or API.

# Public demo sign-in values (safe to show in the UI).
VITE_DEMO_OTP=123456
VITE_DEMO_PASSWORD=demo1234
VITE_DEMO_3DS_CODE=123456

# Human contact shown on the legal pages and in ParkSure Assist.
# The phone value must be dialable (E.164 or with a leading +); the display
# value is what visitors see.
VITE_SUPPORT_EMAIL=support@parksure.demo
VITE_SUPPORT_PHONE=+913340001234
VITE_SUPPORT_PHONE_DISPLAY=+91 33 4000 1234

# Canonical origin used for SEO tags, sitemap links and social previews.
# Change this to the real HTTPS domain before launch.
VITE_SITE_URL=https://parksure.example

# Optional first-party analytics collector. Leave empty to keep analytics
# local-only. If set, it must be an HTTPS endpoint you control.
VITE_ANALYTICS_ENDPOINT=
